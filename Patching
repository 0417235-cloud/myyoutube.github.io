// 1. Replace with your actual YouTube Data API Key
const API_KEY = 'YOUR_YOUTUBE_API_KEY'; 

// 2. The function that fetches videos from YouTube
async function fetchYouTubeVideos(searchQuery = 'programming') {
    const url = `https://googleapis.com{encodeURIComponent(searchQuery)}&type=video&key=${API_KEY}`;

    try {
        const response = await fetch(url);
        const data = await response.json();

        if (data.items) {
            displayVideos(data.items);
        } else {
            console.error('No videos found or API limit reached', data);
        }
    } catch (error) {
        console.error('Error fetching data from YouTube API:', error);
    }
}

// 3. The function that clears the old layout and inserts the new live videos
function displayVideos(videos) {
    const videoGrid = document.querySelector('.video-grid');
    videoGrid.innerHTML = ''; // Clear hardcoded dummy cards

    videos.forEach(item => {
        const videoId = item.id.videoId;
        const title = item.snippet.title;
        const channelTitle = item.snippet.channelTitle;

        // Build a fresh video card layout for each search result
        const cardHTML = `
            <div class="video-card">
                <iframe src="https://youtube.com{videoId}" allowfullscreen></iframe>
                <div class="video-info">
                    <h3>${title}</h3>
                    <p>${channelTitle}</p>
                </div>
            </div>
        `;
        
        videoGrid.innerHTML += cardHTML;
    });
}

// 4. Run the function automatically when the page finishes loading
window.addEventListener('DOMContentLoaded', () => {
    fetchYouTubeVideos('lofi music'); // Default search topic when page opens
});
